# Copy to .env. Local secrets are never returned to the browser.
TEXT_API_BASE=https://api.openai.com/v1
TEXT_API_KEY=
TEXT_DAILY_LIMIT=50
TEXT_MODEL=
# Download the noon service-account key after opening the seller account.
NOON_CREDENTIALS_FILE=
# Explicitly enable content submission only after account/category validation.
NOON_ENABLE_CONTENT_SUBMIT=0
